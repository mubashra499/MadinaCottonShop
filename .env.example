# ──────────────────────────────────────────────────────
# Madina Cotton Shop — Environment Configuration
# ──────────────────────────────────────────────────────
# Copy this file to ".env" and fill in real values.
# Never commit the real .env file or share secret keys.

# Supabase project URL (found in Supabase Dashboard → Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key (found in Supabase Dashboard → Settings → API)
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ──────────────────────────────────────────────────────
# Frontend URL — used for password reset email links
# ──────────────────────────────────────────────────────
# Local development:  http://localhost:5173
# Production:         https://your-actual-domain.com
#
# This URL is passed to Supabase Auth as the redirectTo target
# when a customer clicks "Forgot Password". Supabase sends an
# email containing a reset link that points back to this URL.
#
# IMPORTANT: Whatever value you use here MUST also be added to
# the "Redirect URLs" allowlist in:
#   Supabase Dashboard → Authentication → URL Configuration
# Otherwise Supabase will reject the redirect and the email
# link will not work.
#
# If left blank, the app falls back to window.location.origin
# (works for local dev and production as long as the origin
# is allowlisted in Supabase).
VITE_APP_URL=http://localhost:5173
